/.*/
!/.github/
# Local development environments
.venv/
/.venv-*/
/.tox/
/.nox/
node_modules/

# Python caches and local secrets
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/
/build/
/dist/
*.egg-info/
.env
.env.*
!.env.example

# Credentials and signing material
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
.netrc
.npmrc
.pypirc

# Raw datasets and downloaded archives stay local
data/raw/
/data/public_demo_index/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Machine-specific workspace state and generated outputs
.vscode/
.local-tools/
outputs/
release/

# Temporary audit output
*.tmp
/.tmp*/
/tmp*/
/.tmp-*.log
/.e2_test_tmp/
/docx_render_tmp_*/
/.phase4-*/
/.phase5-*/
/p4-full-flow-*/
/%SystemDrive%/

# Local owner-facing documents and video-production media
/docs/*.docx
/docs/mermaid-diagram.svg
/video_work/
